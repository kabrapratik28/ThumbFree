@@ -982,6 +1032,30 @@ bool precompute_enc_proj_ggml(const HostJoint &    j,
     return true;
 }

+// The encoder projection on the session's thread count nt, whatever the
+// steps use (nt_loop): on the steps' pool when it has nt threads or more,
+// else on a transient pool of its own, then back to the steps' count and pool.
+static bool precompute_enc_proj_session(const HostJoint &    j,
+                                        PredGraph &          pg,
+                                        int                  nt,
+                                        int                  nt_loop,
+                                        const float *        enc_out,
+                                        int                  T,
+                                        int                  d_enc,
+                                        std::vector<float> & out) {
+    const bool transient = nt > nt_loop;
+    if (transient) {
+        set_backend_threadpool(pg.backend, nullptr);
+    }
+    set_backend_threads(pg.backend, nt);
+    const bool ok = precompute_enc_proj_ggml(j, pg.backend, enc_out, T, d_enc, out);
+    set_backend_threads(pg.backend, nt_loop);
+    if (transient) {
+        set_backend_threadpool(pg.backend, pg.tp);
+    }
+    return ok;
+}
