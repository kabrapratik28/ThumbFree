@@ -636,6 +644,44 @@ static int resolve_decode_threads(int n_threads) {
     return n_threads > 0 ? n_threads : transcribe::default_n_threads();
 }

+// Threads for the per-step predictor and joint graphs:
+// TRANSCRIBE_DECODER_THREADS=N, or the session's count (unset or 0), as
+// before. Their matmuls are small (2560x640 at most) and a step's graph
+// has up to 28 nodes, each ending in a barrier across the threads, so on
+// a phone a step with several threads is mostly barriers and wake-ups
+// (83 ms for JFK's 177 steps on a Pixel 10 with 5 threads, several times
+// their memory traffic); one or two threads may do better there, and a
+// phone sweep picks the default. One thread has no barrier. The encoder
+// projection before the loop, one real GEMM, keeps the session's count
+// (precompute_enc_proj_session).
+static int resolve_loop_threads(int session_threads) {
+    const char * v = transcribe::env::str("TRANSCRIBE_DECODER_THREADS");
+    if (v == nullptr || *v == '\0') {
+        return session_threads;
+    }
+    const int n = std::atoi(v);
+    return n > 0 ? n : session_threads;
+}
+
+// Points a CPU backend at a threadpool (null: a pool per graph) through the
+// registry (DL-safe).
+static void set_backend_threadpool(ggml_backend_t backend, ggml_threadpool_t pool) {
+    if (auto tp_set = (pfn_set_threadpool) cpu_backend_proc(backend, "ggml_backend_cpu_set_threadpool")) {
+        tp_set(backend, pool);
+    }
+}
+
+// Sets a CPU backend's thread count through the registry (DL-safe).
+static void set_backend_threads(ggml_backend_t backend, int n_threads) {
+    if (ggml_backend_dev_t dev = ggml_backend_get_device(backend)) {
+        auto set_n_threads = (ggml_backend_set_n_threads_t) ggml_backend_reg_get_proc_address(
+            ggml_backend_dev_backend_reg(dev), "ggml_backend_set_n_threads");
+        if (set_n_threads != nullptr) {
+            set_n_threads(backend, std::max(1, n_threads));
+        }
+    }
+}
