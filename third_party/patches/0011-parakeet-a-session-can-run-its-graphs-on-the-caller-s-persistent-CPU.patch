+// Points the CPU backends of `backends` at the session's persistent pool
+// (transcribe_session_set_threads), or back at a pool per graph (null). The
+// backends belong to the model and outlive the pool: reset after the
+// compute (which also pauses the pool).
+static void set_cpu_threadpool(const std::vector<ggml_backend_t> & backends, void * pool) {
+    for (ggml_backend_t backend : backends) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(backend);
+        if (dev == nullptr || ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+            continue;
+        }
+        using set_threadpool_t = void (*)(ggml_backend_t, ggml_threadpool_t);
+        auto set_threadpool    = (set_threadpool_t) ggml_backend_reg_get_proc_address(
+            ggml_backend_dev_backend_reg(dev), "ggml_backend_cpu_set_threadpool");
+        if (set_threadpool != nullptr) {
+            set_threadpool(backend, static_cast<ggml_threadpool_t>(pool));
+        }
+    }
+}
