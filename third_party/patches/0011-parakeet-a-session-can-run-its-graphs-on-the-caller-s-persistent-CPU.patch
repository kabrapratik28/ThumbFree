diff --git a/include/transcribe.h b/include/transcribe.h
index d15a9bde..0a53a541 100644
--- a/include/transcribe.h
+++ b/include/transcribe.h
@@ -1669,6 +1669,22 @@ TRANSCRIBE_API void transcribe_set_abort_callback(struct transcribe_session * se
                                                   transcribe_abort_callback   cb,
                                                   void *                      user_data);

+/*
+ * Sets how many CPU threads the session's runs use, and optionally a
+ * persistent ggml CPU thread pool to run their graphs on: a
+ * ggml_threadpool_t with at least n_threads threads, made with the CPU
+ * backend's "ggml_threadpool_new" registry function, whose calling thread
+ * is the one that calls transcribe_run. Without one (NULL) every graph
+ * starts and joins a pool of its own, as before. The caller owns the pool
+ * and frees it only after setting another one (or NULL) or freeing the
+ * session. Parakeet runs its graphs on the pool; other models take only the
+ * thread count. Returns TRANSCRIBE_ERR_INVALID_ARG for a NULL session or
+ * n_threads < 1. Not thread-safe with a run on the same session.
+ */
+TRANSCRIBE_API transcribe_status transcribe_session_set_threads(struct transcribe_session * session,
+                                                                int                         n_threads,
+                                                                void *                      threadpool);
+
 /*
  * True if the most recent transcribe_run was aborted by the installed
  * callback returning true. Reset to false at the top of each
