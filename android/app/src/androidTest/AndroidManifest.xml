<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Exported: the instrumented app starts it, and the test APK is a different package. Its own task affinity:
             with the test package's, ActivityScenario's EmptyActivity joins a task left by an earlier class, and
             finishing it brings this activity back instead of the one under test (HomeScreenTest resume()). -->
        <activity
            android:name="io.github.kabrapratik28.thumbfree.testing.InsertTargetsActivity"
            android:exported="true"
            android:taskAffinity="${applicationId}.targets"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />
        <!-- The chat-like scene of the store screenshots (docs/brand/android). -->
        <activity
            android:name="io.github.kabrapratik28.thumbfree.testing.ChatSceneActivity"
            android:exported="true"
            android:taskAffinity="${applicationId}.chat"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        <!-- The notes-like scene of the store screenshots, with a long made-up note. -->
        <activity
            android:name="io.github.kabrapratik28.thumbfree.testing.NotesSceneActivity"
            android:exported="true"
            android:taskAffinity="${applicationId}.notes"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />
    </application>
</manifest>
