         microphone. -->
    <string name="bubble_label">Dictation, double tap to start or stop</string>
    <string name="bubble_transcribing">Transcribing</string>
    <string name="bubble_loading_model">Loading model</string>
    <string name="bubble_progress">%1$d of %2$d</string>
    <string name="bubble_transcribing_progress">Transcribing, %1$d of %2$d</string>
    <string name="bubble_cancel">Cancel dictation</string>
    <string name="bubble_copy">Copy</string>
    <string name="bubble_insert_here">Insert here</string>
    <string name="bubble_undo">Undo</string>
    <string name="bubble_retry">Retry</string>
    <string name="bubble_dismiss">Dismiss</string>
