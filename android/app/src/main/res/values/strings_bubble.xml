    <string name="bubble_grey_downloading">Speech is downloading, %1$d percent</string>
    <string name="bubble_grey_wifi">Speech is waiting for Wi-Fi</string>
    <string name="bubble_grey_connection">Speech is waiting for a connection</string>
    <string name="bubble_grey_not_started">Speech is not downloaded</string>
    <string name="bubble_grey_retrying">Speech download paused</string>
