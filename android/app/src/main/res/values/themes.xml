<?xml version="1.0" encoding="utf-8"?>
<!-- The window under the Compose UI: day and night backgrounds matching ui.Theme, so the system splash and the first
     frame never flash white in dark mode. -->
<resources>
    <color name="window_background">#FFFFFBF5</color>
    <style name="Theme.App" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
    <!-- Clean up's card (ui.CleanupActivity): a see-through window with no title, no dim and no animation. -->
    <style name="Theme.Cleanup" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
